# =============================================================================
# Конфигурация административного SSH-доступа к VPS — ШАБЛОН (без секретов)
# =============================================================================
# Назначение: параметры локального подключения к серверу по SSH.
# НЕ мобильное env приложения и НЕ Docker runtime env для контейнеров.
# Этот файл можно версионировать в Git: он содержит только пустые значения.
# Реальные значения храните в локальном .env (он игнорируется Git).
#
# Скопируйте в .env и заполните значения. Секреты в чат/логи не вставляйте.
# Перед подключением сверьте отпечаток host key (см. docs/deployment/vps-setup.md).
#
# Обязательные поля (всегда):
#   VPS_HOST         — адрес сервера (IP или имя)
#   VPS_USER         — пользователь для SSH
#   VPS_AUTH_METHOD  — способ авторизации: key (рекомендуется) или password
#   VPS_HOST_KEY     — доверенный ОТПЕЧАТОК host key, сверенный до первого
#                      подключения (это не строка known_hosts; см. инструкцию)
#
# Поля, зависящие от способа авторизации:
#   VPS_AUTH_METHOD=key       → заполняйте VPS_SSH_KEY (локальный ПУТЬ к файлу
#                               приватного ключа, НЕ сам ключ);
#                               VPS_SSH_PASSWORD оставляйте пустым.
#   VPS_AUTH_METHOD=password  → заполняйте VPS_SSH_PASSWORD;
#                               VPS_SSH_KEY оставляйте пустым (путь не нужен).
#
# В обоих случаях в .env хранится только ПУТЬ к ключу или пароль — сами
# приватные ключи, парольные фразы и секреты в файл не записывайте.

# --- Сервер ---
VPS_HOST=81.177.167.12
VPS_SSH_PORT=22
VPS_USER=root

# --- Способ авторизации ---
# Значения: key | password
VPS_AUTH_METHOD=key

# --- Ключевой доступ (для VPS_AUTH_METHOD=key) ---
# Windows-путь к приватному ключу, например: C:\Users\<you>\.ssh\id_ed25519
# Путь указывается в формате Windows и не исполняется как команда.
VPS_SSH_KEY=

# --- Пароль (для VPS_AUTH_METHOD=password) ---
# Заполняйте только при входе по паролю; при авторизации по ключу оставьте пустым.
VPS_SSH_PASSWORD=

# --- Проверка host key ---
# Здесь хранится доверенный ОТПЕЧАТОК host key (например, SHA256:...), который
# вы сверили доверенным способом ДО первого подключения. Это НЕ строка
# known_hosts: полную запись known_hosts добавляйте стандартными средствами
# (ssh-keygen -lf для сверки, затем обычное подключение/ssh-keyscan для записи).
# НЕ отключайте проверку host key. Пример формата (плейсхолдер, не настоящий):
#   VPS_HOST_KEY=SHA256:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VPS_HOST_KEY=